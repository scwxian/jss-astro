---
import StandardLayout from "@layouts/StandardLayout.astro";
import FeaturedProductCarousel from "@components/Carousel/FeaturedProductCarousel.astro";
import "@styles/section-layouts/overlap.css";
import "@styles/section-layouts/grid.css";
import { siteInfo } from "@shared/siteInfo.js";


const title = `${siteInfo.name} | ${siteInfo.description}`;
const description = siteInfo.description;
---

<StandardLayout {title} {description}>
  <!-- Hero — overlap-layout -->
  <section class="overlap-layout">
    <div class="overlap-layout-content">
      <p class="section-subtitle">
        Welcome to <img width="22" height="22" src="https://placehold.co/22x22?text=*" alt="Store icon" class="section-icon" /> {siteInfo.name}
      </p>
      <h1 class="section-title">Quality Products, Fair Prices</h1>
    </div>

    <div class="overlap-layout-image animate-element fade-in">
      <img
        fetchpriority="high"
        width="240"
        height="150"
        src="https://placehold.co/480x300?text=Hero+Image"
        alt={`${siteInfo.name} hero image`}
        style="border-radius: 8px;"
      />
    </div>
    <div class="overlap-layout-content">
      <p class="section-body">
        <b>We curate high-quality products and deliver them right to your door.</b>
        From everyday essentials to premium finds, everything we offer is handpicked and backed by exceptional customer service.
      </p>
      <p class="section-body">Browse our full catalog with confidence — secure checkout, fast shipping, and easy returns.</p>
      <div class="section-cta animate-element slide-from-left delay-animation-small">
        <a href="/shop/" class="button">Browse Products</a>
      </div>
    </div>
  </section>

  <!-- Featured products — carousel example -->
  <section class="center-layout featured-products" style="position: relative;">
    <p class="section-subtitle">Fresh picks</p>
    <h2 class="section-title">Featured Products</h2>
    <FeaturedProductCarousel interval={5000} showDots={false} showButtonsMobile={false} />

    <div class="section-cta animate-element slide-from-bottom delay-animation-small">
      <a href="/shop/" class="button">View All Products</a>
    </div>
  </section>

  <!-- Break — marquee example -->
  <section class="break-section">
    <div class="image-masker-overlay">
      <img
        src="https://placehold.co/480x270?text=Break+Image"
        alt="Decorative break image"
        width="480"
        height="270"
        loading="lazy"
        style="border-radius: 8px;"
      />
    </div>
    <div class="break-section-content">
      <div class="seamless-marquee-container">
        <div class="seamless-marquee-track homepage">
          <div class="seamless-marquee-content">
            <span>Quality You Can Trust</span>
          </div>
          <div class="seamless-marquee-content">
            <span>Quality You Can Trust</span>
          </div>
          <div class="seamless-marquee-content">
            <span>Quality You Can Trust</span>
          </div>
          <div class="seamless-marquee-content" aria-hidden="true">
            <span>Quality You Can Trust</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature — overlap-layout reverse -->
  <section class="overlap-layout reverse">
    <div class="overlap-layout-content animate-element slide-from-left">
      <p class="section-subtitle">
        Flexible plans <img
          width="22"
          height="22"
          src="https://placehold.co/22x22?text=Plan"
          alt="Plan icon"
          class="section-icon mid-sentence"
        /> for everyone
      </p>
      <h2 class="section-title" style="font-size: var(--h3-fs)">Subscription Options</h2>
    </div>

    <div class="overlap-layout-image" style="--top-px: 260px">
      <img
        fetchpriority="high"
        width="166"
        height="163"
        src="https://placehold.co/332x326?text=Subscription+Image"
        alt="Subscription plans illustration"
        style="border-radius: 8px;"
      />
    </div>
    <div class="overlap-layout-content animate-element slide-from-left">
      <p class="section-body">Whether you need a <b>weekly restock</b> or a <b>monthly curated box</b>, we have a plan that fits your rhythm.</p>
      <p class="section-body">Pick your plan, set your schedule, and we'll deliver fresh products on repeat. Pause, modify, or cancel anytime — zero commitments, total flexibility.</p>
      <div class="section-cta animate-element slide-from-bottom delay-animation-small">
        <a href="/shop/subscriptions/" class="button">View Plans</a>
      </div>
    </div>
  </section>

  <!-- Services — grid-layout grid-2 -->
  <section class="grid-layout grid-2" id="services">
    <p class="section-subtitle">
      Why shop with us <img
        width="22"
        height="22"
        src="https://placehold.co/22x22?text=*"
        alt="Star icon"
        class="section-icon mid-sentence"
      />
    </p>

    <div class="animate-element slide-from-bottom">
      <div class="image-masker-overlay">
        <img
          loading="lazy"
          width="131"
          height="94"
          src="https://placehold.co/262x188?text=Premium+Products"
          alt="Premium products illustration"
          style="border-radius: 8px;"
        />
      </div>
      <h2 class="section-title">Premium Products</h2>
      <details>
        <summary>Learn More</summary>
        <div class="details-content">
          <p>
            We source only the best — every item in our catalog is carefully selected for quality, durability, and value. <b>If it's not good enough for us, it's not good enough for you.</b>
          </p>
        </div>
      </details>
      <div class="section-cta animate-element slide-from-bottom">
        <a href="/shop/" class="button">Shop Now</a>
      </div>
    </div>

    <div class="animate-element slide-from-bottom delay-animation-small">
      <div class="image-masker-overlay">
        <img
          loading="lazy"
          width="116"
          height="67"
          src="https://placehold.co/232x134?text=Fast+Delivery"
          alt="Fast delivery illustration"
          style="border-radius: 8px;"
        />
      </div>
      <h2 class="section-title">Fast Delivery</h2>
      <details>
        <summary>Learn More</summary>
        <div class="details-content">
          <p>
            <b>Orders ship within 1–3 business days.</b> Real-time tracking, secure packaging, and reliable courier partners. Domestic and international shipping available.
          </p>
        </div>
      </details>
      <div class="section-cta animate-element slide-from-bottom delay-animation-small">
        <a href="/shipping-policy/" class="button">Shipping Info</a>
      </div>
    </div>
  </section>

  <!-- Break — plain text example -->
  <section class="break-section">
    <div class="image-masker-overlay">
      <img
        src="https://placehold.co/480x270?text=About+Us"
        alt="About us decorative image"
        width="480"
        height="270"
        loading="lazy"
        style="border-radius: 8px;"
      />
    </div>
    <div class="break-section-content">
      <div class="center-layout">
        <p class="section-subtitle">Who we are</p>
        <h2 class="section-title">About {siteInfo.name}</h2>
        <p class="section-body">
          <b>{siteInfo.description}</b>
        </p>
        <p class="section-body">
          We're committed to providing an exceptional shopping experience with transparent pricing, fast shipping, and support you can count on.
        </p>
        <div class="section-cta animate-element slide-from-bottom">
          <a href="/about/" class="button">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="center-layout" id="contact">
    <p class="section-subtitle">
      Got questions? <img
        width="22"
        height="22"
        src="https://placehold.co/22x22?text=?"
        alt="Question mark icon"
        class="section-icon mid-sentence"
      />
    </p>
    <h2 class="section-title">Contact Us</h2>
    <p class="section-body center-text">We'd love to hear from you. Reach out any time.</p>
    <ul class="contact-links">
      <li id="email">
        <a href={`mailto:${siteInfo.email}`}>Email us at {siteInfo.email}</a>
      </li>
      <li id="whatsapp">
        <a href={`https://wa.me/${siteInfo.whatsapp}`} target="_blank" rel="noopener noreferrer">
          Chat on WhatsApp
        </a>
      </li>
      <li id="instagram">
        <a href={siteInfo.socials.instagram} target="_blank" rel="noopener noreferrer">
          Follow us on Instagram
        </a>
      </li>
    </ul>
  </section>

  <style>
  section.featured-products {
    --button-offset: -7%;
    --carousel-track-padding: 0.5rem 0 2rem;
    @media (max-width: 768px) {
      --button-offset: 5%;
      --carousel-track-padding: 0.5rem 0;
      margin-top: 5rem;
    }
  }

  .featured-products .section-cta {
    @media (max-width: 768px) { margin-top: 1rem; }
  }

  #services {
    gap: 2rem 4rem;
  }
  #services > div:not(.section-subtitle) {
    display: grid;
    grid-template-rows: 150px max-content max-content max-content;
  }

  #services .image-masker-overlay {
    z-index: -1;
    align-self: end;
    margin-bottom: -40px;
    justify-self: center;
  }

  #services .section-cta {
    margin-top: auto;
  }

  @media (max-width: 768px) {
    #services > div:not(.section-subtitle) {
      grid-template-rows: auto max-content max-content max-content;
    }
  }

  .contact-links {
    list-style-type: none;
    padding-left: 0;
    font-size: 1rem;
    width: auto;
    margin-bottom: 0;
  }

  .contact-links li {
    display: flex;
    margin-bottom: 1rem;
  }
  .contact-links li a {
    text-decoration: none;
  }
  .contact-links li a:hover {
    text-decoration: underline;
  }

  .contact-links li::before {
    content: "🚀";
    display: inline-block;
    height: 1.4rem;
    width: 1.4rem;
    margin-right: 0.8rem;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
  }
  .contact-links li#email::before { content: "✉️"; }
  .contact-links li#whatsapp::before { content: "💬"; }
  .contact-links li#instagram::before { content: "🖼️"; }
  </style>

  <script>
  import { initAccordionAnimations } from "@scripts/utils.js";

  document.addEventListener("astro:page-load", () => {
    const contentContainer = document.querySelector("main");
    if (!contentContainer) return;

    initAccordionAnimations(contentContainer);
  });
  </script>
</StandardLayout>
