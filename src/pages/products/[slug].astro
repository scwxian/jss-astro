---
import { getCollection } from "astro:content";
import Breadcrumb from "@collections/Breadcrumb.astro";
import ProductCoreUI from "@shop/ProductCoreUI.astro";
import StandardLayout from "@layouts/StandardLayout.astro";
import { buildProductSchema } from "@shop/product-schema.ts";
import { getAssetUrl } from "@scripts/asset-handling/r2-linking.js";
import { siteInfo } from "@shared/siteInfo.js";

export async function getStaticPaths() {
	const products = await getCollection("products", ({ data }) => {
		return data.status !== "draft";
	});

	return products.map((product) => ({
		params: { slug: product.id },
		props: { product },
	}));
}

const { product } = Astro.props;
const { data } = product;

const currency = siteInfo.defaultCurrency;

const categoryName = data.category
	.split("-")
	.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
	.join(" ");

const subCategoryName = data.subCategory
	? data.subCategory
			.split("-")
			.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
			.join(" ")
	: null;

const breadcrumbs = data.subCategory
	? [
			{ name: "Shop", url: "/shop/" },
			{ name: categoryName, url: `/shop/${data.category}/` },
			{
				name: subCategoryName,
				url: `/shop/${data.category}/${data.subCategory.toLowerCase().replace(/\s+/g, "-")}/`,
			},
			{ name: data.name, url: "" },
		]
	: [
			{ name: "Shop", url: "/shop/" },
			{ name: categoryName, url: `/shop/${data.category}/` },
			{ name: data.name, url: "" },
		];

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schemaItem = buildProductSchema(product, pageUrl);

const productImage = data.images.length > 0
	? getAssetUrl("products", product.id, data.images[0])
	: undefined;

const pageTitle = data.seo?.title ?? `${data.name} | ${siteInfo.businessName}`;
const pageDescription = data.seo?.description ?? data.shortDescription;

let lowPrice = data.basePrice;
let highPrice = data.basePrice;
for (const group of data.priceVariantGroups) {
	for (const variant of group.variants) {
		const finalPrice = data.basePrice + variant.price;
		if (finalPrice < lowPrice) lowPrice = finalPrice;
		if (finalPrice > highPrice) highPrice = finalPrice;
	}
}

function ogAvailability(status: string): string {
	const map: Record<string, string> = {
		"out-of-stock": "oos",
		"pre-order": "preorder",
		"active": "instock",
	};
	return map[status] ?? "oos";
}
---

<StandardLayout title={pageTitle} description={pageDescription} {breadcrumbs} {schemaItem} type="product" image={productImage} price={(lowPrice / 100).toFixed(2)} {currency} availability={ogAvailability(data.status)} condition="new">
	<main class="product-page-container">
		<Breadcrumb items={breadcrumbs} />
		<ProductCoreUI {product} />
	</main>

	<style>
		.product-page-container {
			padding: 4rem 0 0;
			@media (max-width: 768px) {
				padding: 2rem 0 0;
			}
		}
	</style>
</StandardLayout>
