---
import { siteInfo } from "@shared/siteInfo.js";
import { shopHubSEO } from "@shop/shopHubSEO.js";
import CollectionHubWrapper from "@collections/CollectionHubWrapper.astro";
import ProductCard from "@shop/ProductCard.astro";
import ShopLayout from "@layouts/ShopLayout.astro";
import { getPaginatedSubCategoryPaths } from "@collections/collection-route-helpers.js";
import { buildProductCollectionSchema } from "@collections/collection-schema.ts";
import { formatCategoryLabel } from "@scripts/utils.js";

export async function getStaticPaths({ paginate }) {
	return await getPaginatedSubCategoryPaths(paginate);
}

const { category, subcategory } = Astro.params;
const { page } = Astro.props;

const categoryName = formatCategoryLabel(category);

const subCategoryName = formatCategoryLabel(subcategory);

const seo = shopHubSEO[subcategory] || {
  title: `${subCategoryName} ${categoryName} | ${siteInfo.name} Shop`,
  description: `Shop ${subCategoryName} from our ${categoryName} collection.`,
   moreInfo: [],
}


const schemaItem = buildProductCollectionSchema(page);
---

<ShopLayout
	title={seo.title}
	description={seo.description}
  moreInfo={seo.moreInfo}
	pageTitle={subCategoryName}
	pageSubtitle={seo.pageSubtitle ?? categoryName}
	currentCategory={category}
	currentSubCategory={subcategory}
	{schemaItem}
>
	<Fragment slot="head">
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
	</Fragment>
	<CollectionHubWrapper {page}>
		{page.data.map((product, i) => <ProductCard product={product} index={i} animate />)}
	</CollectionHubWrapper>
</ShopLayout>
