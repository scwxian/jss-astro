---
import { siteInfo } from "@shared/siteInfo.js";
import { shopHubSEO } from "@shop/shopHubSEO.js";
import CollectionHubWrapper from "@collections/CollectionHubWrapper.astro";
import ProductCard from "@shop/ProductCard.astro";
import ShopLayout from "@layouts/ShopLayout.astro";
import { getPaginatedProductPaths } from "@collections/collection-route-helpers.js";
import { buildProductCollectionSchema } from "@collections/collection-schema.ts";

export async function getStaticPaths({ paginate }) {
	return await getPaginatedProductPaths(paginate);
}

const { page } = Astro.props;
const schemaItem = buildProductCollectionSchema(page);
const seo = shopHubSEO["all"] || {
  title:`Shop All Products | ${siteInfo.name}`,
  description: "Browse our full collection of products. Secure checkout and fast delivery.",
  moreInfo: [],
}
---

<ShopLayout 
  title={seo.title} 
  description={seo.description} 
  moreInfo={seo.moreInfo}
  pageTitle="Shop All" 
  pageSubtitle={seo.pageSubtitle}
  currentCategory="all" 
  {schemaItem}
>
	<Fragment slot="head">
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
	</Fragment>
	<CollectionHubWrapper {page}>
		{page.data.map((product, i) => <ProductCard product={product} index={i} animate />)}
	</CollectionHubWrapper>
</ShopLayout>
