---
---
<div id="cart-backdrop" class="cart-backdrop"></div>
<div id="cart-popover" class="cart-popover" data-visible="false">
	<div class="cart-header">
		<p>Cart</p>
		<button id="cart-close" class="overlay-close-btn" aria-label="Close Cart">&times;</button>
	</div>

	<div id="cart-items" class="cart-items">
	</div>

	<div class="cart-footer">
		<div class="cart-subtotal-wrapper">
			<div class="cart-subtotal">
				<p>Subtotal:</p>
				<p id="cart-subtotal-amount">$0.00</p>
			</div>
			<a href="/checkout" id="cart-checkout-btn" class="button" aria-disabled="true">Checkout</a>
		</div>
		<p class="footer-disclaimer">Final price calculated at checkout</p>
	</div>
</div>

<style>
	/* Backdrop overlay */
	.cart-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(3px);
		z-index: var(--z-cart);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 200ms ease-out,
			visibility 200ms ease-out;
	}

	.cart-backdrop[data-visible="true"] {
		opacity: 1;
		visibility: visible;
	}

	/* Cart popover panel */
	.cart-popover {
		width: min(100%, 320px);
		position: fixed;
		inset: 0 0 0 auto;
		height: 100vh;
		transform: translateX(100%);
		transition: transform 200ms ease-out;
		background: var(--accent-bg);
		z-index: var(--z-cart);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
		--button-size: 18px;
		@media (min-width: 480px) {
			width: min(100%, 420px);
		}
	}

	.cart-popover[data-visible="true"] { transform: translateX(0%); }

	/* header section */
	.cart-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.5rem 1rem;
		padding-top: calc(0.5rem + env(safe-area-inset-top));
		box-shadow: var(--header-shadow);
		background: var(--accent-bg);
		flex-shrink: 0;
		@media only screen and (max-width: 768px) {
			padding-top: calc(0.5rem + env(safe-area-inset-top));
		}
	}

	.cart-header p {
		font-family: var(--serif-font);
		letter-spacing: -0.15rem;
		font-size: 1.5rem;
		margin: 0;
	}

	/* close button */
	.overlay-close-btn { margin-top: -3px; }

	/* cart items wrapper */
	.cart-items {
		flex: 1;
		overflow-y: auto;
		padding: 1rem;
	}

	.cart-footer {
		padding: 1rem 1rem 1.5rem;
		border-top: var(--border-width) solid var(--border);
		background: var(--accent-bg);
		display: flex;
		flex-direction: column;
		padding-bottom: calc(2.5rem + env(safe-area-inset-top));
		gap: 0.8rem;

		@media (max-width: 768px) {
			padding: 1rem 1rem 1.5rem;
			padding-bottom: calc(2.5rem + env(safe-area-inset-top));
		}
	}
	.cart-subtotal-wrapper {
		gap: 3rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		@media (max-width: 768px) {
			gap: 1rem;
		}
	}

	.cart-subtotal {
		display: flex;
		flex-direction: column;
		font-size: 0.95rem;
		@media (max-width: 768px) {
			font-size: 0.9rem;
		}
	}
	.cart-subtotal p {
		margin: 0;
		line-height: 1.3rem;
	}

	#cart-subtotal-amount {
		font-size: 1.3rem;
		font-weight: var(--bold-font-weight);
		@media (max-width: 768px) {
			font-size: 1.2rem;
		}
	}

	.cart-footer .button {
		box-shadow: none;
		width: 100%;
		text-align: center;
	}

	.footer-disclaimer {
		color: var(--text-light);
		margin: 0;
		line-height: 0;
		font-size: 0.7rem;
		text-align: right;
	}
</style>

<style is:global>
	/* cart empty state */
	.cart-empty {
		text-align: center;
		padding: 3rem 1rem;
	}

	.cart-empty p {
		color: var(--text-light);
		margin-bottom: 1.5rem;
	}

	.cart-empty a.button {
		@media (max-width: 768px) {
			font-size: 0.9rem;
		}
	}

	/* cart item removed message */
	.cart-item-removed {
		padding: 1rem;
		background: var(--accent-bg);
		border-left: var(--border-width) solid var(--accent);
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.removed-message {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text);
		line-height: 1.4;
		flex: 1;
	}

	.removed-message strong { color: var(--text); }

	.removed-item-close {
		background: transparent;
		border: none;
		font-size: 2rem;
		line-height: 1;
		color: var(--text-light);
		cursor: pointer;
		padding: 0;
		margin: 0;
		flex-shrink: 0;
		transition: color 0.15s ease;
		box-shadow: none;
	}

  .removed-item-close:enabled:hover,
  .removed-item-close:enabled:active {
		color: var(--text);
		background: transparent;
		transform: none;
		box-shadow: none;
	}

	/* cart per item  */
	.cart-item-image-link { display: block; }
	.cart-item-image-link:hover .cart-item-image img { transform: scale(1.05); }
	.cart-item-name-link { text-decoration: none; color: inherit; }
  .cart-item-name-link:hover .cart-item-name { color: var(--accent); transition: all 150ms ease-in-out;}

	.cart-item-price {
		font-size: 0.9rem;
		margin: 7px 0 0;
     letter-spacing: 0.02rem;
     font-weight: var(--bold-font-weight);
	}

	.cart-item-controls {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.qty-controls {
		display: flex;
		align-items: center;
		height: 40px;
	}

	.qty-btn,
	.qty-btn:hover,
	.qty-btn:active,
	.qty-btn:enabled:hover,
	.qty-btn:enabled:active {
		border: none;
		height: 100%;
		background: none;
		box-shadow: none;
		transform: none;
		width: calc(var(--button-size) + 10px);
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		line-height: 0rem;
	}

	.qty-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
		background: none;
	}
	.qty-btn svg {
		background-color: var(--accent);
		border-radius: 4px;
		padding: 4px;
		color: var(--text);
		width: var(--button-size);
		height: var(--button-size);
	}

	.qty-value {
		min-width: 1.5rem;
		text-align: center;
		font-size: 1.2rem;
		line-height: 1.2rem;
	}

	.remove-btn {
		background: transparent;
		border: none;
		height: 35px;
		padding: 0;
		font-size: 0.75rem;
		color: var(--text-light);
		cursor: pointer;
		text-decoration: underline;
		box-shadow: none;
	}

	.remove-btn:enabled:hover {
		background: transparent;
		transform: none;
		box-shadow: none;
		color: var(--text);
	}
</style>
