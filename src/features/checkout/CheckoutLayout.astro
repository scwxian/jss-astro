---
import BlankLayout from "@layouts/BlankLayout.astro";
import SimpleHeader from "@modules/SimpleHeader.astro";
import CheckoutFallback from "@features/checkout/CheckoutFallback.astro";
import InputTextField from "@components/Forms/InputTextField.astro";
import InputCheckboxField from "@components/Forms/InputCheckboxField.astro";
import AddressForm from "@components/Forms/AddressForm.astro";

import Tooltip from "@components/Tooltips/Tooltip.astro";
import { siteInfo } from "@shared/siteInfo.js";

interface CountryOption {
	value: string;
	label: string;
	states: string[];
}

// Update with your shipping countries and states
const availableCountries: CountryOption[] = [
	{
		value: "US",
		label: "United States",
		states: [
			"Alabama",
			"Alaska",
			"Arizona",
			"Arkansas",
			"California",
			// ...
		],
	},
	{
		value: "CA",
		label: "Canada",
		states: [
			"Alberta",
			"British Columbia",
			"Ontario",
			"Quebec",
			// ...
		],
	},
];

export interface Props {
	title: string;
	description: string;
	showDeliveryToggle?: boolean;
	isSubscription?: boolean;
	fallbackIcon?: string;
	fallbackTitle: string;
	buttonText: string;
	buttonLink: string;
	countries?: CountryOption[];
}

const {
	title,
	description,
	showDeliveryToggle = true,
	isSubscription = false,
	fallbackIcon = "brain",
	fallbackTitle,
	buttonText,
	buttonLink,
	countries = availableCountries,
} = Astro.props;
---

<BlankLayout {title} {description} disableSchema={true} nofollow={true} noindex={true}>
	<SimpleHeader />
	<main>
		<div id="checkout-fallback" style="display:none">
			<CheckoutFallback
				icon={fallbackIcon}
				title={fallbackTitle}
				buttonText={buttonText}
				buttonLink={buttonLink}
			>
				<slot name="fallback-content" />
			</CheckoutFallback>
		</div>

		<div class="checkout-layout" id="checkout-layout" style="display:none">
			<form id="checkout-form" class="checkout-form" novalidate>
				<div>
					<h2 class="section-title">Contact</h2>
					<InputTextField
						id="email"
						label="Email address"
						type="email"
						inputmode="email"
						placeholder="you@email.com"
						autocomplete="email"
						required={true}
						minlength={5}
						maxlength={100}
					/>
				</div>

				<div>
					<h2 class="section-title">Delivery</h2>
					{showDeliveryToggle && (
						<div class="delivery-toggle" role="radiogroup" aria-label="Delivery method">
							<div class="toggle-slider"></div>
							<button type="button" class="toggle-btn active" data-delivery="ship" aria-pressed="true" role="radio">
								<img src="https://placehold.co/26x26?text=Ship" alt="" class="section-icon mid-sentence" />Ship
							</button>
							<button type="button" class="toggle-btn" data-delivery="pickup" aria-pressed="false" role="radio">
								<img src="https://placehold.co/26x26?text=Pick" alt="" class="section-icon mid-sentence" />Pick Up
							</button>
						</div>

					<div class="pickup-info" id="pickup-info" style="display: none;">
						<div class="pickup-details">
							<p class="pickup-name"><strong>{siteInfo.businessName}</strong></p>
							<p class="pickup-address">{siteInfo.address.streetAddress}</p>
							<p class="pickup-address">{siteInfo.address.locality}, {siteInfo.address.postalCode}, {siteInfo.address.region}</p>
							<div class="pickup-time">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7v5l1.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0"/></svg>
								Usually ready in 3 business days</div>
						</div>
						<p class="pickup-price">FREE</p>
					</div>
					)}

					<div id="shipping-section">
					<AddressForm
						prefix="shipping"
						countries={countries}
					/>
					</div>
					<div class="form-row save-info-checkbox" style="margin-top: 0.5rem;">
						<InputCheckboxField
							id="saveInfo"
							label="Remember me on this device.&nbsp;"
						/><Tooltip content="If you check this box, your email and addresses will be saved in our database for 180 days — tied to your browser and device — for your next checkout only. Then, at any future checkout that this box is unchecked, your data will be cleared from our servers. This is an optional feature, leaving this box unchecked means nothing will be saved. We respect and value your data and privacy.">Learn more</Tooltip>
					</div>
				</div>

				<div>
					<h2 class="section-title">Billing</h2>
					<div id="same-as-shipping-wrapper" class="form-row" style="margin-bottom: 1rem;">
						<InputCheckboxField
							id="sameAsShipping"
							label="Same as shipping address"
							checked={true}
						/>
					</div>
					<div id="billing-section" style="display: none;">
						<AddressForm prefix="billing" countries={countries} requireFields={false} />
					</div>
				</div>
			</form>

			<div class="payment-btn-wrapper">
				<button type="submit" form="checkout-form" class="button payment-btn" id="payment-btn" disabled>
					<span class="btn-text">Continue to Payment</span>
					<span class="btn-loader" style="display: none;">
						<svg class="spinner spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
							<path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
						</svg>
					</span>
				</button>
				<div class="error-message" id="payment-error"></div>
			</div>

			<aside class="checkout-summary">
				<div class="checkout-sticky">
					<h2 class="section-title">Order Summary</h2>
					<div class="summary-container">
						<div class="summary-items" id="summary-items"></div>

						<div class="promo-code-section">
							<div class="promo-input-wrapper">
								<InputTextField
									type="hidden"
									id="promoCode"
									label="Promo code"
									placeholder="Enter code"
									maxlength={50}
								/>
								<button type="button" class="button promo-btn" id="promo-btn">
									<span class="btn-text">Apply</span>
									<span class="btn-loader" style="display: none;">
										<svg class="spinner spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
											<path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"/>
										</svg>
									</span>
								</button>
							</div>
							<div class="error-message" id="promo-error"></div>
						</div>

						<div class="summary-totals">
							<div class="total-row">
								<span>Subtotal</span>
								<span id="subtotal">$0.00</span>
							</div>
							<div class="total-row" id="discount-row" style="display: none;">
								<span>Discount</span>
								<span id="discount">-$0.00</span>
							</div>
							<div class="total-row">
								<span>Shipping</span>
								<span id="shipping">To be calculated</span>
							</div>
							<div class="total-row total-final">
								<span>Total</span>
								<span id="total" class="total-amount">$0.00</span>
							</div>
						</div>
					</div>
				</div>
			</aside>
		</div>
	</main>
</BlankLayout>

<style is:global>
body:has(.checkout-layout) { overflow-x: visible; }
body:has(.checkout-layout) > main { overflow-x: visible; }

.form-row .more-info { font-size: 0.95rem; color: var(--text); }
.form-row .more-info:hover,
.form-row .more-info.tooltip-locked { transform: none; }

.cart-item { padding: 1rem 0; }
.cart-item:first-child { padding-top: 0; }
.cart-item-image {position: relative; overflow: visible;}

.item-quantity {
  position: absolute;
  top: -8px;
  right: -6px;
  background: var(--accent);
  color: var(--text);
  font-size: 0.85rem;
  font-weight: var(--bold-font-weight);
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--bg);
}

.variant-choice { color: var(--text)}

.item-price {
  font-size: 0.95rem;
  margin: 0;
  color: var(--text);
  text-align: right;
}
</style>

<style>
.checkout-layout {
  margin: 3rem 0 5rem;
  display: grid;
  grid-template-columns: 6fr 4fr;
  gap: 0 3rem;
  align-items: start;
  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: 0;
  }
}

.checkout-form {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  grid-column: 1;
  grid-row: 1;
}

.section-title {
  font-family: var(--serif-font);
  font-size: var(--h4-fs);
  margin: 0 0 0.75rem 0;
  color: var(--text);
  letter-spacing: -0.10rem;
}

/* Delivery Toggle */
.delivery-toggle {
  display: flex;
  gap: 0;
  border-radius: var(--standard-border-radius);
  background-color: var(--accent-bg);
  overflow: hidden;
  position: relative;
  margin: 1.25rem 1rem 1rem;
  box-shadow: 0 4px 12px var(--image-overlay-color-less);
  z-index: 0;
}

.toggle-slider {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 50%;
  background: var(--accent);
  z-index: 0;
  transition: transform 0.2s cubic-bezier(0.4, 0.0, 0.2, 1);
}

.delivery-toggle:has(.toggle-btn[data-delivery="pickup"].active) .toggle-slider {
  transform: translateX(100%);
}

.toggle-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  background: transparent;
  border: none;
  color: var(--text-light);
  font-family: var(--sans-font);
  font-weight: var(--bold-font-weight);
  font-size: 1rem;
  letter-spacing: 0.03rem;
  cursor: pointer;
  transition: color 0.2s ease-out;
  position: relative;
  z-index: 1;
  box-shadow: none;
  transform: none;
}



.toggle-btn:enabled:hover { background-color: transparent; box-shadow: none; transform: none; }
.toggle-btn:not(.active):hover { color: var(--text); }
.toggle-btn.active { color: var(--text); }

.section-icon {
  width: 26px;
  height: 26px;
}

/* Pick Up Info Box */
.pickup-info {
  padding: 1rem 1.5rem;
  background: var(--bg);
  border: var(--border-width) solid var(--border);
  border-radius: var(--standard-border-radius);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.5rem;
  @media (max-width: 768px) {
    flex-direction: column;
    text-align: center;
  }
}

.pickup-details { flex: 1; }
.pickup-name { margin: 0 0 0.25rem 0; font-size: 1.2rem; }
.pickup-address { margin: 0; font-size: 0.9rem; color: var(--text-light); line-height: 1.3; }

.pickup-time {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  margin: 0.5rem 0 0 0;
  font-size: 0.85rem;
  color: var(--text-light);
  @media (max-width: 768px) { justify-content: center; }
}
.pickup-time svg { width: 14px; height: 14px; }

.pickup-price {
  text-align: right;
  font-family: var(--sans-font);
  font-size: 1.2rem;
  font-weight: var(--bold-font-weight);
  letter-spacing: 0.08rem;
  margin: 0;
  @media (max-width: 768px) { text-align: center; }
}

.save-info-checkbox { display: flex; align-items: center;}
.payment-btn-wrapper {
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  grid-column: 1;
  grid-row: 2;
  @media (max-width: 768px) {
    grid-row: 3;
  }
}

.payment-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.payment-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-loader { display: flex; align-items: center; width: 100%; height: 100%; justify-content: center;}

/* Order Summary */
.checkout-summary {
  grid-column: 2;
  grid-row: 1/ span 2;
  height: 100%;
  position: relative;
  z-index: 0;
  background: none;
  @media (max-width: 768px) { grid-column: 1; grid-row: 2; margin-top: 2rem; position: static; }
}

.checkout-sticky {
  position: sticky;
  top: 15%;
  @media (max-width: 768px) { position: static; }
}

.summary-container {
  background: var(--accent-bg);
  border: var(--border-width) solid var(--border);
  border-radius: var(--standard-border-radius);
  padding: 1rem;
}

.summary-items {
  display: flex;
  flex-direction: column;
  margin-bottom: 0.75rem;
  padding-bottom: 0.75rem;
  border-bottom: var(--border-width) solid var(--border);
}

/* Promo Code Section */
.promo-code-section { margin-bottom: 1rem; display: none;}
.promo-input-wrapper { display: flex; gap: 0.75rem; align-items: stretch; }
.promo-input-wrapper .input-wrapper { flex: 1; }

.promo-btn {
  flex-shrink: 0;
  min-width: 80px;
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
  box-shadow: none;
  transform: none;
}
.promo-btn:enabled:hover,
.promo-btn:enabled:active { box-shadow: none; transform: none; }
.promo-btn:disabled { opacity: 0.6; cursor: not-allowed; box-shadow: none; transform: none;}

.error-message {
  margin-top: 0.5rem;
  font-size: 0.85rem;
  color: var(--error);
  display: none;
  line-height: 1rem;
}
.error-message:not(:empty) { display: block; }

.summary-totals { display: flex; flex-direction: column; gap: 0.25rem; }

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.95rem;
  color: var(--text);
}

.total-final {
  padding-top: 0.75rem;
  margin-top: 0.75rem;
  border-top: calc(var(--border-width) * 2) solid var(--border);
  font-size: 1.3rem;
  font-weight: var(--bold-font-weight);
  font-family: var(--sans-font);
}

</style>
