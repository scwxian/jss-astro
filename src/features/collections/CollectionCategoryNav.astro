---
import { getCollection } from "astro:content";
import { formatCategoryLabel } from "@scripts/utils.js";

export interface Props {
	collection: string;
	basePath: string;
	categoryPath?: string;
	published?: (item: any) => boolean;
	currentCategory?: string;
}

const {
	collection,
	basePath,
	categoryPath = basePath,
	published = (item: any) => item.data.status !== "draft",
	currentCategory = "all",
} = Astro.props;

const allItems = await getCollection(collection as any);
const publishedItems = allItems.filter(published);

const uniqueCategorySlugs = [...new Set(publishedItems.map((item: any) => item.data.category))].filter(
	Boolean
) as string[];

const dynamicCategories = uniqueCategorySlugs
	.map((slug) => ({
		label: formatCategoryLabel(slug),
		slug: slug.toLowerCase(),
		href: `${categoryPath}/${slug.toLowerCase()}/`,
	}))
	.sort((a, b) => a.label.localeCompare(b.label));

const categories = [{ label: "All", slug: "all", href: `${basePath}/` }, ...dynamicCategories];
---

<nav class="category-nav" aria-label="Categories" transition:persist="shop-category-nav">
	<ul class="category-list">
		{
			categories.map((cat) => (
				<li>
					<a
						href={cat.href}
						data-category-slug={cat.slug}
						class:list={["category-link", { active: currentCategory === cat.slug }]}
						aria-current={currentCategory === cat.slug ? "page" : undefined}
					>
						{cat.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.category-nav {
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}
	.category-nav::-webkit-scrollbar { display: none; }

	.category-list {
		font-size: 0.95rem;
		display: flex;
		gap: 0.55rem;
		list-style: none;
		padding: 0;
		margin: 0;
		/* flex-wrap: wrap; */ /* For if we want horizontal scrolling*/
		@media (max-width: 768px) {
			justify-content: flex-start;
			flex-wrap: wrap;
		}
	}
	.category-list li { flex-shrink: 0; }

	.category-link {
		white-space: nowrap;
		letter-spacing: 0.02rem;
		font-weight: 500;
		display: inline-block;
		padding: 0.3rem 1rem;
		border-radius: calc(var(--standard-border-radius) / 2);
		background-color: var(--accent-bg);
		color: var(--text-light);
		text-decoration: none;
		font-family: var(--sans-font);
		transition: all 0.15s ease-in-out;
	}

	.category-link:hover,
	.category-link.active {
		background-color: var(--accent);
		border-color: var(--accent);
		color: var(--text);
	}

	@media (max-width: 768px) {
		.category-link:hover {
			background-color: none;
			border-color: none;
			color: var(--text);
		}
	}

	.category-link.active:hover { cursor: default; }

	.category-link:focus-visible { outline: calc(var(--border-width) * 3) solid var(--text); }
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		const nav = document.querySelector(".category-nav");
		if (!nav) return;

		const stateProvider = document.querySelector("[data-active-category]");
		if (!stateProvider) return;

		const activeSlug = stateProvider.getAttribute("data-active-category");

		const links = nav.querySelectorAll(".category-link");
		links.forEach((link) => {
			const linkSlug = link.getAttribute("data-category-slug");

			if (linkSlug === activeSlug) {
				link.classList.add("active");
				link.setAttribute("aria-current", "page");
			} else {
				link.classList.remove("active");
				link.removeAttribute("aria-current");
			}
		});
	});
</script>
