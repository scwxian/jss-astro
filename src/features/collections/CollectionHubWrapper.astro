---
import type { Page } from "astro";
import "@styles/section-layouts/grid.css";
export interface Props {
	page: Page<any>;
}

const { page } = Astro.props;
---

<div class="collection-grid-container">
	<ul data-collection-grid class="grid-layout collection-grid">
		<slot />
	</ul>
	<div class="collection-grid-spinner" aria-hidden="true">
		<div class="shop-loading-spinner-icon"></div>
	</div>
</div>

{
	page.url.next && (
		<nav class="pagination-nav">
			<a href={page.url.next} data-infinite-scroll-trigger class="button load-more-button">
				Load More
			</a>
		</nav>
	)
}

<style>
	.collection-grid-container {
		position: relative;
	}

	.collection-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		grid-template-columns: repeat(var(--mobile-cols, 2), 1fr);
		transition: opacity 0.3s ease;
		@media (min-width: 769px) {
			grid-template-columns: repeat(var(--desktop-cols, 4), 1fr);
		}
	}

	.collection-grid.is-loading { opacity: 0.2; pointer-events: none; }
	.collection-grid-spinner {
		position: absolute;
		top: 200px;
		left: 50%;
		transform: translate(-50%, -50%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		z-index: 5;
		@media (max-width: 768px) { top: 150px; }
	}

	.collection-grid.is-loading ~ .collection-grid-spinner { opacity: 1; }

	.shop-loading-spinner-icon {
		width: 42px;
		height: 42px;
		border: 4px solid var(--accent-bg);
		border-top-color: var(--accent);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	.pagination-nav {
		display: flex;
		justify-content: center;
		margin-top: 4rem;
		margin-bottom: 2rem;
	}
</style>

<script src="./infinite-scroller.js"></script>
