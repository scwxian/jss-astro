---
---

<dialog id="quick-view-modal" class="quick-view-modal">
	<div class="quick-view-actions">
		<button id="quick-view-close" class="close-btn" aria-label="Close Modal">&times;</button>
		<a id="quick-view-expand" class="expand-btn" aria-label="View Full Page">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				shape-rendering="crispEdges"
				viewBox="0 0 8 8"
				><path d="M4 0h4v1H4z"></path><path d="M7 0h1v4H7zM6 1h1v1H6zM5 2h1v1H5zM4 3h1v1H4zM0 7h4v1H0z"></path><path
					d="M0 4h1v4H0zM1 6h1v1H1zM2 5h1v1H2zM3 4h1v1H3z"></path></svg
			>
		</a>
	</div>
	<div id="quick-view-content" class="modal-scroll-area">
		<div id="quick-view-loader" style="display: none;" class="loader">Loading...</div>
		<div id="quick-view-injection"></div>
	</div>
</dialog>

<script src="./quick-view-modal.js"></script>

<style>
	.quick-view-modal {
		border: none;
		padding: 0;
		border-radius: var(--standard-border-radius);
		background: var(--bg);
		max-width: 900px;
		width: 90%;
		overflow: hidden;
		@media (max-width: 768px) {
			width: 100%;
			max-width: 100%;
			margin: auto auto 0 auto;
			border-bottom-left-radius: 0;
			border-bottom-right-radius: 0;
			border-top-left-radius: calc(var(--standard-border-radius) * 2);
			border-top-right-radius: calc(var(--standard-border-radius) * 2);
		}
	}

	#quick-view-content {
		max-width: 100%;
		justify-self: center;
	}
	#quick-view-injection {
		padding: 2rem 3rem;
		@media (max-width: 768px) {
			padding: 3.5rem 1rem;
		}
	}

	.loader {
		padding: 4rem;
		text-align: center;
		font-family: var(--serif-font);
		color: var(--text-light);
		margin-top: 1rem;
		font-size: 1.6rem;
	}

	.quick-view-modal:focus-visible() {
		outline: none;
	}
	.quick-view-modal::backdrop {
		background: rgb(0, 0, 0, 0.85);
		backdrop-filter: blur(4px);
	}
	.modal-scroll-area {
		max-height: 90vh;
		overflow-y: auto;
	}

	.quick-view-actions {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		@media (max-width: 768px) {
			flex-direction: row-reverse;
			top: 0.6rem;
			right: 1rem;
		}
	}

	.expand-btn,
	.close-btn,
	.expand-btn:hover,
	.expand-btn:active,
	.close-btn:enabled:hover,
	.close-btn:enabled:active {
		height: 32px;
		width: 32px;
		z-index: 10;
		background: none;
		transform: none;
		box-shadow: none;
		border: 0;
		color: var(--text-light);
		padding: 0;
		margin: 0;
		transition: all 50ms linear;
	}

	.close-btn {
		font-size: 2.5rem;
		line-height: 1rem;
	}

	.expand-btn {
		display: flex;
		justify-content: center;
		align-items: center;
		@media (max-width: 768px) {
			margin-top: 2px;
		}
	}
  .expand-btn svg{
    width: 18px;
    height: 18px;
		@media (max-width: 768px) {
      width: 16px;
      height: 16px;
		}
  }

	.close-btn:enabled:hover,
	.expand-btn:hover {
		color: var(--text);
	}

	.quick-view-content {
		padding: 3rem;
		@media (max-width: 768px) {
			padding: 3.5rem 0 0 0;
		}
	}

	/* ANIMATION */
	@media (min-width: 769px) {
		.quick-view-modal[open] {
			animation: fadeScale 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
		}

		@keyframes fadeScale {
			0% {
				opacity: 0;
				transform: scale(0.95) translateY(20px);
			}
			100% {
				opacity: 1;
				transform: scale(1) translateY(0);
			}
		}
	}

	@media (max-width: 768px) {
		.quick-view-modal[open] {
			animation: slideUp 0.3s ease-out forwards;
		}

		@keyframes slideUp {
			0% {
				opacity: 0;
				transform: translateY(100%);
			}
			100% {
				opacity: 1;
				transform: translateY(0);
			}
		}
	}
</style>
