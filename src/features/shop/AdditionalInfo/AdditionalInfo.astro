---
export interface AdditionalInfoItem {
	summary: string;
	content: string;
}

export interface Props { items?: AdditionalInfoItem[]; }
const { items } = Astro.props;
if (!items || items.length === 0) { return; }
---

<additional-info-accordion class="additional-info p-0">
	<h2>More Info</h2>
	{
		items.map((item) => (
			<details class="info-accordion">
				<summary class="info-summary">{item.summary}</summary>
				<div class="details-content">
					<p>{item.content}</p>
				</div>
			</details>
		))
	}
</additional-info-accordion>


<script src="./additional-info.js"></script>
