---
export interface Props {
	videoId: string;
	videoSnippet?: string;
	alt?: string;
	class?: string;
}

const { videoId, videoSnippet, alt = "YouTube Video Embed", class: className = "" } = Astro.props;

const posterUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
---

<div class={`video-facade ${className}`} data-video-id={videoId}>
	<img
		src={posterUrl}
		{alt}
		loading="lazy"
		onerror={`this.onerror=null; this.src='https://img.youtube.com/vi/${videoId}/hqdefault.jpg';`}
	/>

	{videoSnippet && <video src={videoSnippet} autoplay loop muted playsinline class="video-snippet" />}

	<div class="video-overlay">
		<button class="play-button" aria-label="Play Video">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
				<path
					fill="currentColor"
					fill-rule="evenodd"
					d="M278.313 48.296a42.67 42.67 0 0 1 15.876 15.876l182.478 319.336c11.691 20.46 4.583 46.523-15.876 58.214a42.67 42.67 0 0 1-21.169 5.621H74.667C51.103 447.343 32 428.241 32 404.677a42.67 42.67 0 0 1 5.622-21.169L220.099 64.172c11.691-20.46 37.755-27.567 58.214-15.876"
				></path>
			</svg>
		</button>
	</div>
</div>

<style>
	.video-facade {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		cursor: pointer;
		overflow: hidden;
		background-color: var(--text);
	}

	.video-facade img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border: none;
		transition: transform 0.4s ease;
	}

	.video-facade:hover img {
		transform: scale(1.03);
	}

	.video-facade .video-overlay {
		z-index: 2;
		position: absolute;
		inset: 0;
		background-color: rgba(0, 0, 0, 0.2);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background-color 0.3s ease;
	}

	.video-facade:hover .video-overlay {
		background-color: rgba(0, 0, 0, 0.4);
	}

	.video-facade .video-snippet {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
		opacity: 0;
		transition: opacity 0.6s ease-in-out;
		pointer-events: none;
	}

	.video-facade .video-snippet.is-playing {
		opacity: 1;
	}

	.video-facade:hover .video-snippet {
		transform: scale(1.03);
		transition:
			transform 0.4s ease,
			opacity 0.6s ease-in-out;
	}

	.video-facade .play-button {
		padding: 0;
		aspect-ratio: 1;
		width: min(13vw, 80px);
		height: min(13vw, 80px);
		border-radius: 50%;
		background-color: var(--accent);
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-left: 5px;
		transition:
			transform 0.2s ease,
			background-color 0.2s ease;
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
	}

	.video-facade .play-button svg {
		width: 50%;
		height: 50%;
		transform: rotate(90deg);
		color: var(--bg);
	}

	.video-facade:hover .play-button {
		transform: scale(1.1);
		background-color: var(--accent-hover);
	}

	.video-facade iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 10;
	}

	@media (max-width: 768px) {
		.video-facade .play-button {
			padding-left: 2px;
		}
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		const facades = document.querySelectorAll(".video-facade");

		facades.forEach((facade) => {
			if (facade.dataset.initialized) return;
			facade.dataset.initialized = "true";

			const videoId = facade.dataset.videoId;
			if (!videoId) return;

			const video = facade.querySelector(".video-snippet");
			if (video) {
				video.addEventListener(
					"playing",
					() => {
						video.classList.add("is-playing");
					},
					{ once: true }
				);
			}

			facade.addEventListener(
				"click",
				() => {
					const iframe = document.createElement("iframe");
					iframe.setAttribute("src", `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`);
					iframe.setAttribute("frameborder", "0");
					iframe.setAttribute(
						"allow",
						"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					);
					iframe.setAttribute("allowfullscreen", "true");

					facade.innerHTML = "";
					facade.appendChild(iframe);
				},
				{ once: true }
			);
		});
	});
</script>
