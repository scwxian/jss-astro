---
export interface Props {
	steps: string[]; 
	activeStep: number;
}

const { steps, activeStep } = Astro.props;
if (activeStep < 1 || activeStep > steps.length) {
	throw new Error(`activeStep must be between 1 and ${steps.length}`);
}
---

<div class="progress-bar-container">
	<div class="progress-bar">
		{
			steps.map((step, index) => {
				const stepNumber = index + 1;
				const isCompleted = stepNumber < activeStep;
				const isActive = stepNumber === activeStep;
				const isUpcoming = stepNumber > activeStep;

				return (
					<>
						{index > 0 && (
							<div class:list={["progress-connector", { completed: isCompleted }]} />
						)}
						<div
							class:list={[
								"progress-step",
								{ completed: isCompleted, active: isActive, upcoming: isUpcoming },
							]}
						>
							<div class="progress-step-circle">
								{isCompleted ? "✓" : stepNumber}
							</div>
							<span class="progress-step-label">{step}</span>
						</div>
					</>
				);
			})
		}
	</div>
</div>

<style>
	.progress-bar-container {
		width: 100%;
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.progress-bar-container::-webkit-scrollbar {
		display: none;
	}

	.progress-bar {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		min-width: fit-content;
		padding: 0;
		gap: 0;
	}

  .progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 100px;
    position: relative;
    @media (max-width: 768px) {
      min-width: 80px;
    }
  }

  .progress-step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif-font);
    font-size: 1rem;
    font-weight: var(--bold-font-weight);
    transition: all 0.2s ease-out;
    @media (max-width: 768px) {
      width: 32px;
      height: 32px;
      font-size: 0.85rem;
    }
  }

  .progress-step-label {
    font-family: var(--serif-font);
    font-weight: var(--body-font-weight);
    font-size: 0.85rem;
    text-align: center;
    line-height: 1.3;
    max-width: 80px;
    transition: all 0.2s ease-out;
    @media (max-width: 768px) {
      font-size: 0.75rem;
      max-width: 70px;
    }
  }

	.progress-step.completed .progress-step-circle {
		background: var(--text);
		color: var(--bg);
		border: 2px solid var(--text);
	}
	.progress-step.completed .progress-step-label { color: var(--text); }

	.progress-step.active .progress-step-circle {
		background: var(--accent);
		color: var(--text);
		border: 2px solid var(--accent);
		box-shadow: 0 0 0 4px var(--accent-bg);
	}
	.progress-step.active .progress-step-label { color: var(--accent); }

	.progress-step.upcoming .progress-step-circle {
		background: transparent;
		border: 2px solid var(--text-light);
		color: var(--text-light);
	}
	.progress-step.upcoming .progress-step-label { color: var(--text-light); }

  .progress-connector {
    flex: 1;
    height: 2px;
    background: var(--border);
    margin: 0;
    position: relative;
    top: 20px;
    z-index: -1;
    min-width: 20px;
    @media (max-width: 768px) {
      top: 16px;
      min-width: 15px;
    }
  }
	.progress-connector.completed { background: var(--text); }

</style>
