---
const { legend = "Pick a Date" } = Astro.props
---
<date-picker>
	<fieldset class="variant-group">
    <legend>{legend}</legend>
		<input type="text" name="subscription_start" class="date-input" placeholder="Select a date..." required />
	</fieldset>
</date-picker>

<style is:global>
.date-input {
	width: 100%;
	padding: 0.75rem;
	border: calc(var(--border-width) * 2) solid var(--border);
	border-radius: var(--standard-border-radius);
	font-family: var(--sans-font);
	color: var(--text);
	background: var(--bg);
	font-size: 1rem;
}

.date-input::placeholder {
	color: var(--text-light);
}

.date-input:focus {
	outline: none;
	border-color: var(--accent);
}
.flatpickr-calendar {
	background: transparent;
	opacity: 0;
	display: none;
	text-align: center;
	visibility: hidden;
	padding: 0;
	animation: none;
	direction: ltr;
	border: 0;
	font-size: 14px;
	line-height: 24px;
	border-radius: var(--standard-border-radius);
	position: absolute;
	width: 307.875px;
	box-sizing: border-box;
	touch-action: manipulation;
	z-index: 99999;
}

.flatpickr-calendar.open,
.flatpickr-calendar.inline {
	opacity: 1;
	max-height: 640px;
	visibility: visible;
	background: var(--bg);
	border: var(--border-width) solid var(--border);
}

.flatpickr-calendar.open {
	display: inline-block;
}

.flatpickr-calendar.animate.open {
	animation: fpFadeInDown 300ms cubic-bezier(0.23, 1, 0.32, 1);
}

.flatpickr-calendar.inline {
	display: block;
	position: relative;
	top: 2px;
}

.flatpickr-calendar.static {
	position: absolute;
	top: calc(100% + 2px);
}

.flatpickr-calendar.static.open {
	z-index: 999;
	display: block;
}

/* Calendar Arrow (positioning only) */
.flatpickr-calendar:before,
.flatpickr-calendar:after {
	position: absolute;
	display: block;
	pointer-events: none;
	border: solid transparent;
	content: "";
	height: 0;
	width: 0;
	left: 22px;
}

.flatpickr-calendar.rightMost:before,
.flatpickr-calendar.arrowRight:before,
.flatpickr-calendar.rightMost:after,
.flatpickr-calendar.arrowRight:after {
	left: auto;
	right: 22px;
}

.flatpickr-calendar.arrowCenter:before,
.flatpickr-calendar.arrowCenter:after {
	left: 50%;
	right: 50%;
}

.flatpickr-calendar:before {
	border-width: 5px;
	margin: 0 -5px;
}

.flatpickr-calendar:after {
	border-width: 4px;
	margin: 0 -4px;
}

.flatpickr-calendar.arrowTop:before,
.flatpickr-calendar.arrowTop:after {
	bottom: 100%;
}

.flatpickr-calendar.arrowTop:before {
	border-bottom-color: var(--border);
}

.flatpickr-calendar.arrowTop:after {
	border-bottom-color: var(--bg);
}

.flatpickr-calendar.arrowBottom:before,
.flatpickr-calendar.arrowBottom:after {
	top: 100%;
}

.flatpickr-calendar.arrowBottom:before {
	border-top-color: var(--border);
}

.flatpickr-calendar.arrowBottom:after {
	border-top-color: var(--bg);
}

.flatpickr-calendar:focus {
	outline: 0;
}

/* Wrapper */
.flatpickr-wrapper {
	position: relative;
	display: inline-block;
	width: 100%;
}

/* Months Container */
.flatpickr-months {
	display: flex;
	background: var(--accent-bg);
	border-radius: var(--standard-border-radius) var(--standard-border-radius) 0 0;
}

.flatpickr-months .flatpickr-month {
	background: transparent;
	color: var(--text);
	fill: var(--text);
	line-height: 1;
	text-align: center;
	position: relative;
	user-select: none;
	overflow: hidden;
	flex: 1;
	display: flex;
	justify-content: center;
}

/* Navigation Arrows */
.flatpickr-months .flatpickr-prev-month,
.flatpickr-months .flatpickr-next-month {
	user-select: none;
	text-decoration: none;
	cursor: pointer;
	position: absolute;
	top: 0;
	padding: 11px 12px;
	z-index: 3;
	color: var(--text);
	fill: var(--text);
	transition: all 100ms ease-in-out;
}

.flatpickr-months .flatpickr-prev-month.flatpickr-disabled,
.flatpickr-months .flatpickr-next-month.flatpickr-disabled {
	display: none;
}

.flatpickr-months .flatpickr-prev-month i,
.flatpickr-months .flatpickr-next-month i {
	position: relative;
}

.flatpickr-months .flatpickr-prev-month.flatpickr-prev-month,
.flatpickr-months .flatpickr-next-month.flatpickr-prev-month {
	left: 0;
}

.flatpickr-months .flatpickr-prev-month.flatpickr-next-month,
.flatpickr-months .flatpickr-next-month.flatpickr-next-month {
	right: 0;
}

.flatpickr-months .flatpickr-prev-month:hover,
.flatpickr-months .flatpickr-next-month:hover {
	color: var(--accent);
}

.flatpickr-months .flatpickr-prev-month:hover svg,
.flatpickr-months .flatpickr-next-month:hover svg {
	fill: var(--accent);
}

.flatpickr-months .flatpickr-prev-month svg,
.flatpickr-months .flatpickr-next-month svg {
	width: 14px;
	height: 14px;
}

.flatpickr-months .flatpickr-prev-month svg path,
.flatpickr-months .flatpickr-next-month svg path {
	fill: inherit;
}

/* Current Month Display */
.flatpickr-current-month {
	line-height: inherit;
	font-weight: var(--body-font-weight);
	color: var(--text);
	max-width: 220px;
	width: 75%;
	line-height: 1;
	display: inline-block;
	display: flex;
	align-items: center;
	justify-content: center;
}

.flatpickr-current-month .flatpickr-monthDropdown-months {
	text-align: right;
	background: none;
	border: none;
	box-sizing: border-box;
	color: var(--text);
	cursor: pointer;
	font-size: 1.2rem;
	font-family: var(--sans-font);
	font-weight: var(--body-font-weight);
	height: auto;
	line-height: 24px;
	padding: 8px 8px;
	width: auto;
	letter-spacing: 0.02rem;
	transition: all 100ms ease-in-out;
}

.flatpickr-current-month .flatpickr-monthDropdown-months:hover {
	/* background: var(--accent-hover); */
	color: var(--accent-hover);
}

/* Down arrow SVG for month dropdown */
.flatpickr-current-month .flatpickr-monthDropdown-months + svg {
	width: 8px;
	height: 5px;
	margin-left: 4px;
	vertical-align: middle;
	fill: var(--text);
	transition: fill 100ms ease-in-out;
}

.flatpickr-current-month .flatpickr-monthDropdown-months:hover + svg {
	fill: var(--accent);
}

.flatpickr-current-month .flatpickr-monthDropdown-months .flatpickr-monthDropdown-month {
	background: var(--bg);
	color: var(--text);
	padding: 4px 8px;
}

.flatpickr-current-month .flatpickr-monthDropdown-months .flatpickr-monthDropdown-month:hover {
	color: var(--accent-hover);
}

.flatpickr-current-month .numInputWrapper {
	display: inline-block;
	position: relative;
	height: auto;
}

.flatpickr-current-month input.cur-year {
	background: transparent;
	letter-spacing: 0.02rem;
	box-sizing: border-box;
	color: var(--text);
	font-family: var(--sans-font);
	margin-top: 1px;
	font-size: 1.2rem;
	font-weight: var(--body-font-weight);
	line-height: inherit;
	border: none;
}

.flatpickr-current-month input.cur-year:focus {
	outline: 0;
}

.flatpickr-current-month input.cur-year[disabled] {
	opacity: 0.5;
	cursor: default;
}

/* Weekdays */
.flatpickr-weekdays {
	background: transparent;
	padding: 8px 0;
	text-align: center;
	overflow: hidden;
}

.flatpickr-weekday {
	background: transparent;
	color: var(--text-light);
	cursor: default;
	display: inline-block;
	flex: 1;
	font-size: 90%;
	font-weight: var(--bold-font-weight);
	line-height: 1;
	margin: 0;
	text-align: center;
	width: 14.2857143%;
}

.flatpickr-weekwrapper {
	display: inline-block;
	padding: 0 4px;
	flex: 1;
}

.flatpickr-weekwrapper .flatpickr-weeks {
	padding: 0 4px;
}

.flatpickr-weekwrapper .flatpickr-weekday {
	height: 24px;
	line-height: 24px;
	padding: 0 2px;
	width: 100%;
}

.flatpickr-weekwrapper span.flatpickr-week {
	font-size: 80%;
	font-weight: var(--body-font-weight);
	color: var(--text-light);
}

/* Days Container */
.flatpickr-days {
	position: relative;
	overflow: hidden;
	display: flex;
	width: 100%;
}

.flatpickr-days:focus {
	outline: 0;
}

.dayContainer {
	padding: 0;
	outline: 0;
	text-align: left;
	width: 100%;
	min-width: 100%;
	max-width: 100%;
	display: inline-block;
	display: -ms-flexbox;
	display: flex;
	flex-wrap: wrap;
	-ms-flex-wrap: wrap;
	justify-content: space-around;
	transform: translate(0, 0);
	opacity: 1;
}

.dayContainer + .dayContainer {
	border-left: var(--border-width) solid var(--border);
}

/* Individual Day Cells */
.flatpickr-day {
	background: transparent;
	border: none;
	color: var(--text);
	cursor: pointer;
	display: inline-block;
	position: relative;
	justify-content: center;
	text-align: center;
	width: 14.2857143%;
	flex-basis: 14.2857143%;
	max-width: 39px;
	height: 39px;
	line-height: 39px;
	margin: 0;
	border-radius: var(--standard-border-radius);
	font-weight: var(--body-font-weight);
	transition: background-color 0.1s;
}

.flatpickr-day:hover {
	background: var(--accent-bg);
	cursor: pointer;
	outline: 0;
}

.flatpickr-day:focus {
	outline: 0;
}

.flatpickr-day.today {
	border: var(--border-width) solid var(--accent);
}

.flatpickr-day.today:hover {
	background: var(--accent-bg);
}

.flatpickr-day.selected {
	background: var(--accent);
	color: var(--bg);
	border: none;
}

.flatpickr-day.selected:hover {
	background: var(--accent-hover);
}

.flatpickr-day.inRange {
	background: var(--accent-bg);
	border-color: transparent;
}

.flatpickr-day.startRange,
.flatpickr-day.endRange {
	border-radius: var(--standard-border-radius);
}

.flatpickr-day.startRange:hover,
.flatpickr-day.endRange:hover {
	background: var(--accent);
	color: var(--bg);
}

.flatpickr-day.startRange.endRange {
	border-radius: var(--standard-border-radius);
}

.flatpickr-day.flatpickr-disabled,
.flatpickr-day.flatpickr-disabled:hover {
	background: transparent;
	color: var(--disabled);
	cursor: default;
}

.flatpickr-day.prevMonthDay,
.flatpickr-day.nextMonthDay {
	color: var(--text-light);
	opacity: 0.5;
}

.flatpickr-day.week.selected {
	border-radius: 0;
	background: var(--accent-bg);
}

/* Time Picker */
.flatpickr-time {
	text-align: center;
	outline: 0;
	display: block;
	height: 0;
	line-height: 40px;
	max-height: 40px;
	box-sizing: border-box;
	overflow: hidden;
	display: flex;
	background: var(--bg);
	border-radius: 0 0 var(--standard-border-radius) var(--standard-border-radius);
}

.flatpickr-time:after {
	content: "";
	display: table;
	clear: both;
}

.flatpickr-time .numInputWrapper {
	flex: 1;
	width: 40%;
	height: 40px;
	float: left;
}

.flatpickr-time .numInputWrapper span {
	opacity: 0;
	position: absolute;
	right: 0;
	border: var(--border-width) solid var(--border);
	border-radius: var(--standard-border-radius);
	box-sizing: border-box;
	margin: -1px 0 0 0;
	padding: 0;
	width: 14px;
	right: calc(50% - 7px);
}

.flatpickr-time .numInputWrapper span:hover {
	background: var(--accent);
}

.flatpickr-time .numInputWrapper span:active {
	background: var(--accent-hover);
}

.flatpickr-time .numInputWrapper span.arrowUp {
	top: 0;
	border-bottom: 0;
}

.flatpickr-time .numInputWrapper span.arrowUp:after {
	border-left: 4px solid transparent;
	border-right: 4px solid transparent;
	border-bottom: 4px solid var(--text-light);
	top: 26%;
}

.flatpickr-time .numInputWrapper span.arrowDown {
	top: 50%;
}

.flatpickr-time .numInputWrapper span.arrowDown:after {
	border-left: 4px solid transparent;
	border-right: 4px solid transparent;
	border-top: 4px solid var(--text-light);
	top: 40%;
}

.flatpickr-time .numInputWrapper span:hover {
	opacity: 1;
}

.flatpickr-time .numInputWrapper:hover span {
	opacity: 1;
}

.flatpickr-time.hasSeconds .numInputWrapper {
	width: 26%;
}

.flatpickr-time.time24hr .numInputWrapper {
	width: 49%;
}

.flatpickr-time input {
	background: transparent;
	box-shadow: none;
	border: 0;
	border-radius: 0;
	text-align: center;
	margin: 0;
	padding: 0;
	height: inherit;
	line-height: inherit;
	color: var(--text);
	font-size: 14px;
	position: relative;
	box-sizing: border-box;
	appearance: textfield;
}

.flatpickr-time input.flatpickr-hour {
	font-weight: var(--bold-font-weight);
}

.flatpickr-time input.flatpickr-minute,
.flatpickr-time input.flatpickr-second {
	font-weight: var(--body-font-weight);
}

.flatpickr-time input:focus {
	outline: 0;
	border: 0;
}

.flatpickr-time .flatpickr-time-separator,
.flatpickr-time .flatpickr-am-pm {
	height: inherit;
	float: left;
	line-height: inherit;
	color: var(--text);
	font-weight: var(--bold-font-weight);
	width: 2%;
	user-select: none;
	align-self: center;
}

.flatpickr-time .flatpickr-am-pm {
	outline: 0;
	width: 18%;
	cursor: pointer;
	text-align: center;
	font-weight: var(--body-font-weight);
}

.flatpickr-time input:hover,
.flatpickr-time .flatpickr-am-pm:hover,
.flatpickr-time input:focus,
.flatpickr-time .flatpickr-am-pm:focus {
	background: var(--accent-bg);
}

.flatpickr-input[readonly] {
	cursor: pointer;
}

/* Animation Keyframes (Required for .animate.open) */
@keyframes fpFadeInDown {
	from {
		opacity: 0;
		transform: translate3d(0, -20px, 0);
	}
	to {
		opacity: 1;
		transform: translate3d(0, 0, 0);
	}
}
</style>
