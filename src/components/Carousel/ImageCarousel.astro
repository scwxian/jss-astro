---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseCarousel from "./BaseCarousel.astro";

export interface Slide {
	src: ImageMetadata | string;
	alt: string;
	href?: string;
}

export interface Props {
	slides: Slide[];
	interval?: number;
	class?: string;
	style?: string;
	imageClass?: string;
	showButtons?: boolean;
	showDots?: boolean;
	showButtonsMobile?: boolean;
	showDotsMobile?: boolean;
	customWidth?: number;
	trackStyles?: string;
	navMarginTop?: string;
	dotsOffset?: string;
	shadow?: "none" | "left" | "right" | "soft";
	outline?: boolean;
	background?: boolean;
}

const {
	slides,
	interval,
	class: className = "",
	style: inlineStyle,
	imageClass = "",
	showButtons,
	showDots,
	showButtonsMobile,
	showDotsMobile,
	customWidth,
	trackStyles,
	navMarginTop,
	dotsOffset,
	shadow = "none",
	outline = false,
	background = false,
} = Astro.props;

// Determines if a string URL is a public asset (Rule 2). Public assets use root-relative paths starting with '/'.
const isPublicAsset = (src: string): boolean => {
	return src.startsWith("/") && !src.startsWith("//");
};
---

<BaseCarousel
  slideCount={slides.length}
  {interval}
  class={className}
  style={inlineStyle}
  {showButtons}
  {showDots}
  {showButtonsMobile}
  {showDotsMobile}
  {customWidth}
  {trackStyles}
  {navMarginTop}
  {dotsOffset}
>
	{
		slides.map((slide) => {
			const isPublic = typeof slide.src === "string" && isPublicAsset(slide.src);
			const ImageContent = isPublic ? (
        // Rule 2: Public assets use plain <img> (no optimization needed)
				<img src={slide.src} alt={slide.alt} class={imageClass} loading="eager" />
			) : typeof slide.src === "string" ? (
				// Rule 1: R2/remote URLs - use <Image> with inferSize for build-time optimization
        <Image 
              src={slide.src}
              alt={slide.alt}
              class={imageClass}
              loading="eager"
              inferSize
              widths={[320, 640, 960, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
        />
			) : (
				// Rule 3: Imported assets (ImageMetadata)
        <Image 
              src={slide.src}
              alt={slide.alt}
              class={imageClass}
              loading="eager"
              widths={[320, 640, 960, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
        />
			);

			const slideClass = [
        "carousel-slide",
        shadow !== "none" && `shadow-${shadow}`,
        outline && "outline",
        background && "bg",
      ].filter(Boolean).join(" ");

			return (
				<div class={slideClass}>
					{slide.href ? (
						<a href={slide.href} target="_blank" rel="noopener noreferrer">
							{ImageContent}
						</a>
					) : (
						ImageContent
					)}
				</div>
			);
		})
	}
</BaseCarousel>

<style>
	.square-thumb {
		aspect-ratio: 1 / 1;
		object-fit: cover;
		width: 100%;
		border-radius: var(--standard-border-radius);
		border: var(--border-width) solid var(--border);
		box-shadow: -4px 4px 0px 0px var(--accent-bg);
	}

	.shadow-left { box-shadow: -4px 4px 0px 0px var(--disabled); }
	.shadow-right { box-shadow: 4px 4px 0px 0px var(--disabled); }
	.shadow-soft { box-shadow: var(--disabled); }
	.outline {
		border: calc(var(--border-width) * 2) solid var(--border);
		border-radius: var(--standard-border-radius);
	}
	.bg { background: var(--accent-bg); }
</style>
