---
import { Image } from "astro:assets";
import BaseCarousel from "./BaseCarousel.astro";
import { getAssetUrl } from "@scripts/asset-handling/r2-linking.js";

export interface Video {
	provider: "youtube" | "self-hosted";
	url: string;
}

export interface Props {
	images: string[];
	video?: Video;
	productName: string;
	/** The content collection name (e.g., "products", "blog") */
	collection?: string;
	/** The entry slug/ID for R2 path construction */
	slug?: string;
	interval?: number;
	class?: string;
	imageClass?: string;
	showButtons?: boolean;
	altContext?: string;
}

const {
	images,
	video,
	productName,
	collection = "products",
	slug = "",
	interval,
	class: className = "",
	imageClass = "",
	showButtons = true,
	altContext,
} = Astro.props;

// Build slides array: images first, then video if present
// Images are resolved through getAssetUrl which handles both R2 and external URLs
const imageSlides = images.map((img, index) => ({
	type: "image" as const,
	src: getAssetUrl(collection, slug, img),
	alt:
		index === 0
			? `${productName}${altContext ? ` - ${altContext}` : ""} - Product Photo`
			: `${productName} - Image ${index + 1}`,
}));

const videoSlides = video
	? [
			{
				type: "video" as const,
				provider: video.provider,
				url: video.provider === "self-hosted" ? getAssetUrl(collection, slug, video.url) : video.url,
				alt: `${productName} - Video`,
			},
		]
	: [];

const slides = [...imageSlides, ...videoSlides];
---

<BaseCarousel slideCount={slides.length} {interval} class={className} {showButtons}>
	{
		slides.map((slide) => {
			if (slide.type === "image") {
				return (
					<div class="carousel-slide">
            <Image 
              src={slide.src} 
              alt={slide.alt}
              inferSize
              class={imageClass} 
              widths={[320, 640, 960, 1200]}
              sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
            />
					</div>
				);
			}

			if (slide.type === "video") {
				if (slide.provider === "youtube") {
					// Extract YouTube video ID from URL
					const videoId = slide.url.match(
						/(?:youtube\.com\/embed\/|youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/
					)?.[1];

					return (
						<div class="carousel-slide">
							<iframe
								src={`https://www.youtube.com/embed/${videoId}`}
								title={slide.alt}
								class={imageClass}
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
								allowfullscreen
							/>
						</div>
					);
				}

				// Self-hosted video
				return (
					<div class="carousel-slide">
						<video src={slide.url} class={imageClass} controls preload="metadata">
							<track kind="captions" />
						</video>
					</div>
				);
			}
		})
	}
</BaseCarousel>

<style>
	.carousel-slide iframe,
	.carousel-slide video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--standard-border-radius);
	}
</style>
