---
import { Image } from "astro:assets";
import { siteInfo } from "@shared/siteInfo.js";
import logo from "@assets/images/logo.png";
import { getCollection } from "astro:content";
import { formatCategoryLabel } from "@scripts/utils.js";

const logoAlt = `${siteInfo.name} Home`;

const allProducts = await getCollection("products");
const publishedProducts = allProducts.filter((p) => p.data.status !== "draft");
const uniqueCategories = [...new Set(publishedProducts.map((p) => p.data.category))].filter(Boolean) as string[];
const headerCategories = uniqueCategories
	.map((slug) => ({
		label: formatCategoryLabel(slug),
		slug,
		href: `/shop/${slug}/`,
	}))
	.sort((a, b) => a.label.localeCompare(b.label));
---

<site-header role="banner" transition:name="site-header" transition:persist="site-header">
	<div class="top-navbar-content">
		<a href="/" id="logo">
			<Image src={logo} alt={logoAlt} />
		</a>

		<button class="mobile-nav-toggle" aria-controls="primary-navigation" aria-expanded="false">
			<span class="sr-only">Menu</span>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
				focusable="false"
			>
				<title>Menu</title>
				<rect y="6" width="24" height="2" rx="1"></rect>
				<rect y="13" width="24" height="2" rx="1"></rect>
				<rect y="20" width="24" height="2" rx="1"></rect>
			</svg>
		</button>

		<div class="nav-links">
			<nav>
				<button class="mobile-nav-close" aria-label="Close menu">&times;</button>
				<ul>
					<li class="nav-dropdown">
						<a
							href="/shop/"
							class="nav-dropdown-trigger"
							data-dropdown-trigger
							aria-haspopup="true"
							aria-expanded="false"
						>
							Shop
						</a>
						<ul class="nav-dropdown-menu">
							<li><a href="/shop/">All Products</a></li>
							{headerCategories.map((cat) => (
								<li><a href={cat.href}>{cat.label}</a></li>
							))}
						</ul>
					</li>
					<li><a href="/blog/">Blog</a></li>
					<li><a href="/about/">About</a></li>
					<li><a href="/#contact">Contact</a></li>
					<li><a href="/faq/">FAQ</a></li>
				</ul>
			</nav>

			<div class="social-links-block">
				<p class="section-subtitle">Catch Us On Socials</p>
				<div class="social-links">
					<a href={siteInfo.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<img src="https://placehold.co/28x28?text=IG" width="28" height="28" alt="Instagram Icon" />
					</a>
					<a href={`https://wa.me/${siteInfo.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Us">
						<img src="https://placehold.co/28x28?text=WA" width="28" height="28" alt="WhatsApp Icon" />
					</a>
				</div>
			</div>
		</div>

		<button id="scrollToTop" title="Go to top">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="currentColor"
				aria-hidden="true"
				shape-rendering="crispEdges"
				viewBox="0 0 5 3"><path d="M2 0h1v1H2zM1 1h1v1H1zM3 1h1v1H3zM0 2h1v1H0zM4 2h1v1H4z"></path></svg
			>
		</button>
  <div id="nav-backdrop" class="nav-backdrop"></div>
	</div>

	<style>
		site-header {
			padding: 1rem 0.5rem;
			padding-top: calc(1.5rem + env(safe-area-inset-top));
			position: sticky;
			top: 0;
			width: 100%;
			height: fit-content;
			z-index: var(--z-header);
			transition:
				box-shadow 0.3s ease-in-out,
				background-color 0.3s ease-in-out;
			box-shadow: var(--header-shadow);
		}

		site-header.is-scrolled {
			background-color: var(--accent-bg);
			box-shadow: none;
		}

		nav {
			font-size: 1rem;
			line-height: 2;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			width: 100%;
		}

		#logo > img {
			max-width: 70px;
			vertical-align: middle;
		}

		@media only screen and (max-width: 768px) {
			#logo > img {
				max-width: 50px;
				vertical-align: middle;
			}
			site-header {
				padding: 1rem 0.5rem;
				padding-top: calc(1rem + env(safe-area-inset-top));
				background-color: var(--bg);
			}
		}

		.top-navbar-content {
			grid-column: 2;
			align-items: center;
			justify-content: space-between;
			display: flex;
		}

		@media (min-width: 1021px) {
			.top-navbar-content > .nav-links {
				flex-direction: row;
			}
		}

		.top-navbar-content > .nav-links p {
			display: none;
		}

		#scrollToTop {
			display: none;
			position: fixed;
			bottom: 30px;
			right: 30px;
			z-index: 99;
			width: 35px;
			height: 35px;
			padding: 0;
			border: none;
			background-color: var(--accent);
			box-shadow: none;
			color: var(--text);
			cursor: pointer;
		}

		#scrollToTop:enabled:active,
		#scrollToTop:enabled:hover {
			transform: none;
		}

		#scrollToTop > svg {
			height: 18px;
			width: 18px;
			margin-top: 4px;
		}

		.mobile-nav-toggle,
		.mobile-nav-close {
			display: none;
		}

		/* Nav backdrop */
		.nav-backdrop {
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.5);
			backdrop-filter: blur(3px);
			z-index: var(--z-nav-backdrop);
			opacity: 0;
			visibility: hidden;
			transition:
				opacity 200ms ease-out,
				visibility 200ms ease-out;
		}

		.nav-backdrop[data-visible="true"] {
			opacity: 1;
			visibility: visible;
		}

		/* Dropdown nav */
		.nav-dropdown-trigger {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
		}
		.nav-dropdown-trigger::before {
			content: "";
			position: absolute;
			left: -5px;
			width: 0.40rem;
			height: 0.40rem;
			border-top: 0.3rem solid transparent;
			border-bottom: 0.3rem solid transparent;
			border-left: 0.4rem solid currentColor;
			transition: transform 0.1s ease;
		}
		.nav-dropdown-expanded .nav-dropdown-trigger::before { transform: rotate(90deg); }
		.nav-dropdown-menu { display: none; list-style: none; padding: 0; margin: 0; }

		.nav-dropdown-menu a::after,
		.nav-dropdown-trigger::after { content: none; }

		@media (min-width: 1021px) {
			.nav-dropdown { position: relative; }
			.nav-dropdown-menu {
				position: absolute;
				top: 100%;
				left: 0;
				background: var(--bg);
				z-index: 100;
				box-shadow: var(--shadow-lg, 0 4px 12px rgba(0,0,0,0.1));
			}
			.nav-dropdown-expanded .nav-dropdown-menu,
			.nav-dropdown:focus-within .nav-dropdown-menu {
				display: block;
			}
			.nav-dropdown-expanded .nav-dropdown-trigger::before,
			.nav-dropdown:focus-within .nav-dropdown-trigger::before {
				transform: rotate(90deg);
			}
			.nav-dropdown-menu li {
				margin: 0;
				width: 100%;
			}
			.nav-dropdown-menu a {
				display: block;
				padding: 0.4rem 1rem;
				white-space: nowrap;
				text-decoration: none;
				color: var(--text);
				transition: background 0.15s ease;
			}
			.nav-dropdown-menu a:hover,
			.nav-dropdown-menu a:focus-visible {
				background-color: var(--accent-bg);
				color: var(--text);
			}
		}

		@media (max-width: 1020px) {
			site-header {
				position: static;
			}

			.top-navbar-content > .nav-links {
				position: fixed;
				inset: 0 0 0 auto;
				width: min(100%, 250px);
				transform: translateX(100%);
				transition: transform 200ms ease-out;
				padding: 1rem 2rem 0;
				gap: 3rem;
				background-color: var(--accent-bg);
				z-index: var(--z-nav-mobile);
				align-items: flex-end;
				justify-content: flex-start;
			}

			.top-navbar-content > .nav-links p {
				display: block;
			}

			.top-navbar-content > .nav-links > .social-links-block > .social-links {
				justify-content: flex-end;
			}

			.nav-links[data-visible="true"].nav-links[data-visible="true"] {
				transform: translateX(0%);
			}

			.mobile-nav-toggle,
			.mobile-nav-close,
			.mobile-nav-toggle:enabled:hover,
			.mobile-nav-toggle:enabled:active,
			.mobile-nav-close:enabled:hover,
			.mobile-nav-close:enabled:active {
				display: block;
				background: none;
				transform: none;
				box-shadow: none;
				border: 0;
				color: var(--text);
				padding: 0;
				margin: 0;
			}

			.mobile-nav-toggle { width: 2rem; height: 2rem; }
			.mobile-nav-toggle.nav-open { visibility: hidden; }

			.mobile-nav-close,
			.mobile-nav-close:enabled:hover,
			.mobile-nav-close:enabled:active {
				font-size: 2.5rem;
				margin-bottom: 1.5rem;
				align-self: flex-end;
			}

			nav ul,
			nav ol { align-items: flex-start; }

			.nav-dropdown {
				display: flex;
				flex-direction: column;
			}
			.nav-dropdown-menu {
				display: block;
				gap: 0.25rem;
				line-height: 1rem;
				overflow: hidden;
				height: 0;
			}
			.nav-dropdown-expanded .nav-dropdown-menu {
				height: auto;
			}
			.nav-dropdown-menu li {
				display: list-item;
				text-align: left;
				margin: 0 0 0.4rem 0.5rem;
			}
		}
	</style>

	<style is:global>
		site-header:has(~ main section:first-of-type.inverted) {
			background-color: var(--accent-bg);
		}
		::view-transition-group(site-header) {
			z-index: 9999;
		}
	</style>

	<script>
		class SiteHeader extends HTMLElement {
			connectedCallback() {
				if (this.dataset.initialized) {
					return;
				}
				this.dataset.initialized = "true";

				const header = this;
				const nav = this.querySelector(".nav-links");
				const navBackdrop = document.getElementById("nav-backdrop");
				const navToggle = this.querySelector(".mobile-nav-toggle");
				const navClose = this.querySelector(".mobile-nav-close");
				const scrollTopButton = this.querySelector("#scrollToTop");
				const logoLink = this.querySelector("#logo");
				const isMobile = window.innerWidth <= 1020;

				this.updateActiveLink();

				document.addEventListener("astro:page-load", () => {
					this.updateActiveLink();
				});

				if (!isMobile && header) {
					window.addEventListener("scroll", () => {
						header.classList.toggle("is-scrolled", window.scrollY > 20);
					});
				}

				if (nav && navToggle && navClose) {
					const openNav = () => {
						nav.setAttribute("data-visible", "true");
						navBackdrop?.setAttribute("data-visible", "true");
						navToggle.setAttribute("aria-expanded", "true");
						navToggle.setAttribute("aria-hidden", "false");
						navToggle.classList.add("nav-open");
						document.body.style.overflow = "hidden";
					};
					const closeNav = () => {
						nav.setAttribute("data-visible", "false");
						navBackdrop?.setAttribute("data-visible", "false");
						navToggle.setAttribute("aria-expanded", "false");
						navToggle.setAttribute("aria-hidden", "true");
						navToggle.classList.remove("nav-open");
						document.body.style.overflow = "";
					};

					navToggle.addEventListener("click", () => {
						const isVisible = nav.getAttribute("data-visible") === "true";
						if (isVisible) {
							closeNav();
						} else {
							openNav();
						}
					});

					logoLink?.addEventListener("click", closeNav);
					navClose.addEventListener("click", closeNav);
					navBackdrop?.addEventListener("click", closeNav);

					nav.addEventListener("click", (e) => {
						const link = e.target.closest("a");
						if (!link) return;
						if (link.classList.contains("nav-dropdown-trigger") && window.innerWidth <= 1020) return;

						// Close dropdown before navigation for Desktop only
						if (window.innerWidth > 1020) {
							const dropdown = link.closest(".nav-dropdown");
							if (dropdown?.classList.contains("nav-dropdown-expanded")) {
								link.blur();
								dropdown.classList.remove("nav-dropdown-expanded");
								const trigger = dropdown.querySelector("[data-dropdown-trigger]");
								trigger?.setAttribute("aria-expanded", "false");
							}
						}

						closeNav();
					});

					// Mobile dropdown toggle
					const dropdownTrigger = this.querySelector(".nav-dropdown-trigger");
					dropdownTrigger?.addEventListener("click", (e) => {
						if (window.innerWidth > 1020) return;
						e.preventDefault();
						const parent = dropdownTrigger.closest(".nav-dropdown");
						const isOpen = parent.classList.contains("nav-dropdown-expanded");
						const menu = parent.querySelector(".nav-dropdown-menu");

						if (menu._anim) menu._anim.cancel();

						if (isOpen) {
							menu._anim = menu.animate(
								{ height: [`${menu.offsetHeight}px`, "0px"] },
								{ duration: 150, easing: "ease-out" },
							);
							menu._anim.onfinish = () => {
								parent.classList.remove("nav-dropdown-expanded");
								menu.style.height = "";
								menu._anim = null;
							};
						} else {
							parent.classList.add("nav-dropdown-expanded");
							menu.style.height = "0px";
							menu._anim = menu.animate(
								{ height: ["0px", `${menu.scrollHeight}px`] },
								{ duration: 150, easing: "ease-out" },
							);
							menu._anim.onfinish = () => {
								menu.style.height = "";
								menu._anim = null;
							};
						}

						const expanded = isOpen ? "false" : "true";
						dropdownTrigger.setAttribute("aria-expanded", expanded);
					});

					// Desktop dropdown hover
					if (window.innerWidth > 1020) {
						const dd = this.querySelector(".nav-dropdown");
						const ddTrigger = dd?.querySelector("[data-dropdown-trigger]");
						if (dd) {
							dd.addEventListener("mouseenter", () => {
								if (window.innerWidth <= 1020) return;
								dd.classList.add("nav-dropdown-expanded");
								ddTrigger?.setAttribute("aria-expanded", "true");
							});
							dd.addEventListener("mouseleave", () => {
								if (window.innerWidth <= 1020) return;
								dd.classList.remove("nav-dropdown-expanded");
								ddTrigger?.setAttribute("aria-expanded", "false");
							});
						}
					}

					document.addEventListener("click", (e) => {
						if (nav.getAttribute("data-visible") !== "true") {
							return;
						}

						const isInsideNav = this.contains(e.target);
						const isToggle = e.target.closest(".mobile-nav-toggle");

						if (!isInsideNav && !isToggle) {
							closeNav();
						}
					});
				}

				// Mobile Scroll To Top Button
				if (scrollTopButton) {
					const handleScroll = () => {
						const scrollPosition = document.body.scrollTop || document.documentElement.scrollTop;

						if (scrollPosition > 100 && window.innerWidth <= 1020) {
							scrollTopButton.style.display = "block";
						} else {
							scrollTopButton.style.display = "none";
						}
					};

					const scrollToTop = () => {
						window.scrollTo({ top: 0, behavior: "smooth" });
					};

					window.addEventListener("scroll", handleScroll);
					window.addEventListener("resize", handleScroll);
					scrollTopButton.addEventListener("click", scrollToTop);
					handleScroll();
				}
			}

			updateActiveLink() {
				const currentUrl = new URL(window.location.href);
				const currentPath = currentUrl.pathname.replace(/\/$/, "") || "/";

				const links = this.querySelectorAll("nav a");

				links.forEach((link) => {
					const url = new URL(link.href);
					const linkPath = url.pathname.replace(/\/$/, "") || "/";
					const linkHash = url.hash;

					link.classList.remove("active");
					link.removeAttribute("aria-current");

					if (linkHash || link.classList.contains("nav-cta-button")) return;

					const isExactMatch = currentPath === linkPath;
					const isDropdownTrigger = link.hasAttribute("data-dropdown-trigger");
					const isSectionMatch = isDropdownTrigger && currentPath.startsWith(linkPath);

					if (isExactMatch || isSectionMatch) {
						link.classList.add("active");
						link.setAttribute("aria-current", "page");
					}
				});
			}
		}

		customElements.define("site-header", SiteHeader);
	</script>
</site-header>
