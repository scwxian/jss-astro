---
import { ClientRouter, slide } from "astro:transitions";
import { Font } from "astro:assets";
import Meta from "@modules/Meta.astro";
import Schema from "@modules/Schema.astro";
import "@styles/global.css";
import { siteInfo } from "@shared/siteInfo.js";

export interface Props {
	title: string;
	description: string;
	href?: string;
	schemaItem?: Record<string, any>;
	disableSchema?: boolean;
	image?: string;
	type?: string;
	noindex?: boolean;
	nofollow?: boolean;
	breadcrumbs?: { name: string; url: string }[];
	price?: string;
	currency?: string;
	availability?: string;
	condition?: string;
}

const {
	title,
	description,
	href = new URL(Astro.url.pathname, Astro.site).href,
	schemaItem,
	disableSchema = false,
	image,
	type,
	noindex,
	nofollow,
	breadcrumbs,
	price,
	currency = siteInfo.defaultCurrency,
	availability,
	condition,
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<Meta {title} {description} {href} {image} {type} {noindex} {nofollow} {price} {currency} {availability} {condition} />

		{
			!disableSchema && (
				<Schema title={title} description={description} url={href} item={schemaItem} breadcrumbs={breadcrumbs} />
			)
		}

		<Font cssVariable="--serif-font" preload />
		<Font cssVariable="--sans-font" preload />
		<ClientRouter />

		<slot name="head" />
	</head>

	<body>
		<slot />
	</body>
</html>

<script>
	let globalAnimationObserver;

	document.addEventListener("astro:page-load", () => {
		const observedElements = document.querySelectorAll(".animate-element");

		if (observedElements.length > 0) {
			globalAnimationObserver = new IntersectionObserver(
				(entries, observerInstance) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observerInstance.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.2 }
			);

			observedElements.forEach((element) => {
				globalAnimationObserver.observe(element);
			});
		}
	});

	document.addEventListener("astro:before-swap", () => {
		if (globalAnimationObserver) {
			globalAnimationObserver.disconnect();
			globalAnimationObserver = null;
		}
	});
</script>
