---
import { ClientRouter, slide } from "astro:transitions";
import { Font } from "astro:assets";
import Meta from "@modules/Meta.astro";
import Schema from "@modules/Schema.astro";
import "@styles/global.css";
import { siteInfo } from "@shared/siteInfo.js";

export interface Props {
	title: string;
	description: string;
	href?: string;
	schemaItem?: Record<string, any>;
	additionalItems?: Record<string, any>[];
	disableSchema?: boolean;
	image?: string;
	type?: string;
	noindex?: boolean;
	nofollow?: boolean;
	breadcrumbs?: { name: string; url: string }[];
	price?: string;
	currency?: string;
	availability?: string;
	condition?: string;
	fabMode?: "default" | "hidden" | "auto";
}

const {
	title,
	description,
	href = new URL(Astro.url.pathname, Astro.site).href,
	schemaItem,
	additionalItems,
	disableSchema = false,
	image,
	type,
	noindex,
	nofollow,
	breadcrumbs,
	price,
	currency = siteInfo.defaultCurrency,
	availability,
	condition,
	fabMode = "default",
} = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		<Meta {title} {description} {href} {image} {type} {noindex} {nofollow} {price} {currency} {availability} {condition} />

		{
			!disableSchema && (
				<Schema title={title} description={description} url={href} item={schemaItem} additionalItems={additionalItems} breadcrumbs={breadcrumbs} />
			)
		}

		<Font cssVariable="--serif-font" preload />
		<Font cssVariable="--sans-font" preload />
		<ClientRouter />

		<slot name="head" />
	</head>

	<body data-fab-mode={fabMode}>
		<slot />
	</body>
</html>

<script>
	document.addEventListener("astro:page-load", () => {
		const observedElements = document.querySelectorAll(".animate-element");

		if (observedElements.length > 0) {
			window.globalAnimationObserver = new IntersectionObserver(
				(entries, observerInstance) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observerInstance.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.2 }
			);

			observedElements.forEach((element) => {
				if (element.getBoundingClientRect().top < window.innerHeight) {
					element.classList.add("is-visible");
				} else {
					window.globalAnimationObserver.observe(element);
				}
			});
		}
	});

	document.addEventListener("astro:before-swap", () => {
		if (window.globalAnimationObserver) {
			window.globalAnimationObserver.disconnect();
			window.globalAnimationObserver = null;
		}
	});
</script>
