# product-seo-tool — internal dev secrets (NOT used by the app/prod).
# Copy to `.env` (same dir) and fill in. `.env` is gitignored.

# DataForSEO (HTTP Basic auth) — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Target market — YOUR call. Required; the tool cannot run without these.
# DF_LOCATION_CODE: DataForSEO numeric location code (e.g. 2840 = United States,
#   2826 = United Kingdom, 2036 = Australia). Full list:
#   https://docs.dataforseo.com/v3/appendix/locations-and-languages/
# DF_LOCATION_NAME: human-readable label shown in the report header.
# DF_LANGUAGE: language code (default: en).
DF_LOCATION_CODE=
DF_LOCATION_NAME=
DF_LANGUAGE=en

# Optional: standard-queue polling (async results arrive after a wait)
DF_POLL_MS=6000
DF_MAX_WAIT_MS=2700000
