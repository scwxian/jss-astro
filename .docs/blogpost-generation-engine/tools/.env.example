# Internal dev-tooling secrets for the blog-generation pipeline.
# Copy to `.env` (same dir) and fill in. `.env` is gitignored (root .gitignore).
# These creds are NOT used by the Astro/Cloudflare app or any production server.

# DataForSEO (Basic auth) — https://app.dataforseo.com/api-access
# SERP · PAA · related · autocomplete · keyword volumes (standard queue)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Market: fill in the market you target (required for any DataForSEO call) ---
# DF_LOCATION_CODE = numeric DataForSEO location code.
# Look yours up: https://docs.dataforseo.com/v3/appendix/locations_and_languages/
DF_LOCATION_CODE=
# DF_LOCATION_NAME = human label for the market (used in logs + scaffold). Optional.
DF_LOCATION_NAME=
# Language code (default "en")
DF_LANGUAGE=en

# Brave Search API — https://api-dashboard.search.brave.com/app/keys
# Global content-discovery leads (editorial depth). Free tier ~1 req/s.
BRAVE_API_KEY=
# Optional: Brave country scope (default "all" = global index)
BRAVE_COUNTRY=all

# Google Cloud Knowledge Graph Search API v1 — https://console.cloud.google.com/apis/library/kgsearch.googleapis.com
# entitycheck.mjs --kgs (numeric resultScore). Optional; DataForSEO panel is the primary signal.
GCLOUD_KGS_KEY=

# entitycheck.mjs: entities to monitor (comma-separated; append =QID to also check Wikidata).
# Example: ENTITY_NAMES=Your Brand=Q123,Founder Name
ENTITY_NAMES=
# entitycheck.mjs --site: canonical site URL whose JSON-LD identity graph to audit.
ENTITY_SITE=

# Optional: DataForSEO standard-queue polling (async results arrive after a wait)
DF_POLL_MS=6000
DF_MAX_WAIT_MS=2700000
